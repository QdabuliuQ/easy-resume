# 青松简历（easy-resume）容器化运行配置
#
# 使用：
#   cp .env.docker.example .env
#   docker compose up -d
#
# 全部留空也能启动：编辑器、本地保存可用；AI、登录、云端同步会降级。
# 导出功能依赖 public/fonts（未纳入版本库），缺失时 PDFKit/DOCX 导出会报错，
# 详见 README「字体」一节。
#
# 完整变量说明（含国内网络代理、七牛、百度 OCR 等）见 .env.local.example
# 注意：.env 含密钥，已被 .gitignore 与 .dockerignore 排除，不会进镜像

# ===========================================================================
# 1. 站点（构建期变量，修改后需重新构建镜像）
# ===========================================================================
# 前端 bundle 在构建时烘焙该值，`docker compose up` 不会生效
# 改它需要：docker compose build --build-arg NEXT_PUBLIC_SITE_URL=https://你的域名
NEXT_PUBLIC_SITE_URL=http://localhost:3010

# 生产环境若经反向代理，Auth.js 需要知道公网地址（本地留空）
# AUTH_URL=https://resume.example.com

# ===========================================================================
# 2. 登录（AUTH_SECRET 留空时会自动生成并持久化到 volume，无需手动填）
# ===========================================================================
# 只有多副本部署或希望固定密钥时才需要显式设置
# AUTH_SECRET=

# GitHub OAuth：https://github.com/settings/developers
# 回调地址需填 http://localhost:3010/api/auth/callback/github
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=

# QQ 互联：https://connect.qq.com/（不支持 localhost 回调）
# AUTH_QQ_ID=
# AUTH_QQ_SECRET=

# 国内网络连不上 github.com 时的代理
# AUTH_GITHUB_PROXY=http://127.0.0.1:7890

# ===========================================================================
# 3. AI 功能（润色 / 对话修改 / 模拟面试）
# ===========================================================================
# https://platform.deepseek.com
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4-flash

# AI 每日配额限流（可选）：https://console.upstash.com
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ===========================================================================
# 4. 数据层（默认由 compose 内的 api 容器提供，无需配置）
# ===========================================================================
# compose 默认把 app 的 CF_API_BASE_URL 指向容器内的 api 服务。
# 若想改回使用云端 Cloudflare Worker，设置下面一行即可覆盖：
# CF_API_BASE_URL=https://api.resume.qdabuliuq.cn
# CF_API_SECRET=

# 主站与数据层之间的通信密钥，两端必须一致。
# 不填会使用镜像内占位值，仅适合本地试用；公网部署前务必修改：
#   openssl rand -base64 32
# CF_API_SECRET=

# 后台接口密钥（worker 的 /api/admin/* 用它校验）。
# 不填会使用占位值，导致后台管理不可用。
# ADMIN_SECRET=

# 用于构建期下载导出字体（可选）
# RESUME_FONT_BASE_URL=https://your.host/fonts

# ===========================================================================
# 5. 简历导入（百度 OCR / 语音识别，可选）
# ===========================================================================
# BAIDU_OCR_API_KEY=
# BAIDU_OCR_SECRET_KEY=
# BAIDU_SPEECH_API_KEY=
# BAIDU_SPEECH_SECRET_KEY=

# ===========================================================================
# 6. 运维后台 /templates 管理（可选）
# ===========================================================================
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change-me-password
# 留空时回退使用 AUTH_SECRET
# ADMIN_SECRET=

# ===========================================================================
# 7. 容器内运行参数（一般无需修改，已在 docker-compose.yml 中设定）
# ===========================================================================
# 关闭启动时的 Chromium 预热可省内存，代价是首次导出变慢
# PDF_EXPORT_WARMUP=0
